{
  "name": "@wake-protocol/server",
  "version": "0.6.0",
  "description": "Framework-agnostic WAKE protocol server (KX, SM, KR, TA, ET) built on Request and Response",
  "keywords": ["wake-protocol", "webauthn", "passkey"],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@wake-protocol/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@wake-protocol/source": "./src/testing.ts"
    }
  },
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json",
    "test": "node --conditions=@wake-protocol/source --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@wake-protocol/core": "0.6.0",
    "@wake-protocol/bytes": "0.6.0",
    "@wake-protocol/codec": "0.6.0",
    "@wake-protocol/crypto": "0.6.0",
    "@scure/base": "2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nozomi-hiragi/wake-protocol.git",
    "directory": "impl/ts/server"
  },
  "homepage": "https://github.com/nozomi-hiragi/wake-protocol/tree/main/impl/ts/server#readme",
  "bugs": {
    "url": "https://github.com/nozomi-hiragi/wake-protocol/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
