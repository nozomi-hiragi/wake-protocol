{
  "name": "@wake-protocol/codec",
  "version": "0.6.0",
  "description": "Length-prefixed codec and text (ASCII/Latin-1/UTF-8) utilities for the WAKE protocol",
  "keywords": ["wake-protocol", "webauthn", "passkey"],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@wake-protocol/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json",
    "test": "node --conditions=@wake-protocol/source --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nozomi-hiragi/wake-protocol.git",
    "directory": "impl/ts/core/codec"
  },
  "homepage": "https://github.com/nozomi-hiragi/wake-protocol/tree/main/impl/ts/core/codec#readme",
  "bugs": {
    "url": "https://github.com/nozomi-hiragi/wake-protocol/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
